# Secrets
.env
.env.*
!.env.example

# Datasets (licensed / large) - only the folder skeleton is tracked
data/**
!data/**/
!data/**/.gitkeep
# data/osm/site_pack.sqlite.gz is NOT committed: its `sites` table holds every CoStar kit
# property's location. Share it privately with the team; see docs/osm-site-map.md.

# Licensed vendor data (Matterport, Vexcel, CoStar) must never be committed, wherever it lands.
# These apply anywhere in the tree, independent of the data/** rule above.
**/raw/matterport/**
**/raw/vexcel/**
**/raw/costar/**
!**/raw/*/.gitkeep
**/costar-hackathon-kit/
**/processed/costar_*.json
**/matterport/floorplans/
**/vexcel_cache/
**/tile_cache/
# Files derived from vendor data (CoStar ids/facts, Matterport scan mapping, Vexcel responses)
configs/real_buildings.yaml
tests/fixtures/vexcel_meta_*.json

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
build/

# Web
node_modules/
dist/
web/.vite/
*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.VSCodeCounter/
