# Copy to .env and fill in. .env is gitignored - never commit real keys.
# The synthetic building runs with every key left empty.

# --- LLM clue extraction (parser/extract.py) ---
# Only "anthropic" is implemented (Claude Haiku 5.5). Used only when the console's
# parser is switched to Claude Haiku; replies are cached on disk.
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Requests allowed per server process before the keyword rules take over (default 200).
# LLM_MAX_CALLS=200

# --- Demo ---
# Building the demo starts on. Default: bundy-olympic if it has been built, else ptc-100.
# DEMO_BUILDING_ID=ptc-100

# --- Raw data and cache folders (gitignored) ---
MATTERPORT_DATA_DIR=./data/raw/matterport
VEXCEL_DATA_DIR=./data/raw/vexcel
COSTAR_DATA_DIR=./data/raw/costar

# --- Matterport (Model API + Embed SDK) ---
# "API key" is the token ID, "API token" is the token secret, "SDK key" is for the browser viewer.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
MATTERPORT_SDK_KEY=

# --- Vexcel (API v2) ---
# Paste the key as ONE line with no spaces. A key copied from a wrapped line picks up
# spaces; the code strips them, but other tools will get a 401.
VEXCEL_API_KEY=
