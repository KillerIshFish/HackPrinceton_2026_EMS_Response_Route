# Copy to .env and fill in. .env is gitignored - never commit real keys.

# LLM clue extraction (parser/extract.py). v0 uses the rule-based stub and ignores these.
# One of: openai | anthropic | gemini
LLM_PROVIDER=anthropic
LLM_API_KEY=

# Raw dataset drop folders (gitignored). v0 uses the synthetic building and ignores these.
MATTERPORT_DATA_DIR=./data/raw/matterport
VEXCEL_DATA_DIR=./data/raw/vexcel
COSTAR_DATA_DIR=./data/raw/costar
